FROM maven:3.9-eclipse-temurin-17 as builder
WORKDIR /app
COPY pom.xml .
COPY src src
RUN mvn clean package -DskipTests

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=builder /app/target/diy-shop-*.jar app.jar
EXPOSE 8081

# Seller credentials come from the .env file referenced by docker-compose.
CMD ["java", "-jar", "app.jar"]
