# Copy to .env before running docker compose.
# Generate a BCrypt hash for your own password, do not reuse this one.
DIY_SHOP_SELLER_USERNAME=admin
DIY_SHOP_SELLER_PASSWORD_HASH=$2a$10$replace.with.your.own.bcrypt.hash

# Comma-separated list of origins allowed to call the API with credentials (CORS).
SHOP_CORS_ALLOWED_ORIGINS=http://localhost:5173
