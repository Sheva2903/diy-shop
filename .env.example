# Backend environment variables.
#
# Copy to .env.local (Git-ignored) and load it before starting Spring Boot:
#
#   cp .env.example .env.local
#   source .env.local
#   ./mvnw spring-boot:run
#
# Never commit real credentials. Keep this file with placeholder values only.

# --- Required: seller account -------------------------------------------------
# The backend fails at startup if these are missing.
# For local development run `npm --prefix frontend run generate:seller` instead:
# it writes the fixed seller/seller123 account to .seller-dev.env for you.
# DIY_SHOP_SELLER_PASSWORD_HASH must be a BCrypt hash, never a plain password.
export DIY_SHOP_SELLER_USERNAME='seller'
export DIY_SHOP_SELLER_PASSWORD_HASH='<bcrypt-hash>'

# --- Required: bank transfer --------------------------------------------------
# The backend fails at startup if these are missing.
# BANK_CODE is the bank identifier used in the public VietQR image URL.
# BANK_BIN is the six-digit Vietnamese bank BIN returned in API responses.
export BANK_TRANSFER_BANK_NAME='Vietcombank'
export BANK_TRANSFER_BANK_CODE='vietcombank'
export BANK_TRANSFER_BANK_BIN='970436'
export BANK_TRANSFER_ACCOUNT_NUMBER='<account-number>'
export BANK_TRANSFER_ACCOUNT_NAME='<account-name>'

# --- Optional: bank transfer --------------------------------------------------
# export BANK_TRANSFER_TEMPLATE='compact'
# export BANK_TRANSFER_PAYMENT_DUE_HOURS='24'

# --- Optional: product image storage ------------------------------------------
# Defaults to local disk under ./uploads/product-images, served at
# /media/product-images/**. Nothing else is needed for local development.
# export IMAGE_STORAGE_PROVIDER='local'
# export IMAGE_STORAGE_LOCAL_DIRECTORY='./uploads/product-images'
# export IMAGE_STORAGE_MAX_FILE_SIZE='5MB'

# For AWS S3, switch the provider and name the bucket. The SDK default
# credential chain is used, so prefer an IAM role over access keys.
# export IMAGE_STORAGE_PROVIDER='s3'
# export IMAGE_STORAGE_S3_BUCKET='<bucket-name>'
# export AWS_REGION='ap-southeast-1'
# export IMAGE_STORAGE_S3_URL_DURATION_MINUTES='60'
